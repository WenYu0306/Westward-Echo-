# Westward Echo — Caddy reverse proxy with automatic HTTPS
# Caddy obtains and renews Let's Encrypt certificates automatically.
# Replace westwardecho.com with your actual domain.
# If you don't have a domain yet, replace with :80 for HTTP-only mode.

westwardecho.com {
    reverse_proxy api:8000

    # Increase timeout for long translation requests (5 minutes)
    transport http {
        response_header_timeout 300s
    }

    # Enable gzip compression for HTML/CSS/JS
    encode gzip

    # Log requests
    log {
        output file /var/log/caddy/access.log
    }
}

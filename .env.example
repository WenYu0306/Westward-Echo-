# === DeepSeek V4 API (primary) ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# V4 dual-mode
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# === Anthropic Claude API (optional arbitration) ===
ANTHROPIC_API_KEY=

# === Redis (task queue broker + backend) ===
REDIS_URL=redis://redis:6379/0

# === Chroma ===
CHROMA_PERSIST_PATH=./data/chroma

# === Checkpoint SQLite ===
CHECKPOINT_DB_PATH=./data/checkpoints.db

# === Authentication ===
# Leave empty for dev mode (no auth required)
API_KEY=

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# === CMS Integration ===
CMS_SOURCE_TYPE=file          # 'file' or 'webhook'
CMS_FILE_BASE_DIR=./novels    # for file connector
CMS_WEBHOOK_URL=              # for webhook connector
CMS_WEBHOOK_API_KEY=          # for webhook connector

# === Server ===
HOST=0.0.0.0
API_PORT=8000

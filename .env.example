# ══════════════════════════════════════════════════════════════════
# LLM providers — 2026-09 定案：全面弃用 DeepSeek，双供应商分工。
# provider 由**模型名**派生（qwen* → LLM_BASE_URL，glm* → GLM_BASE_URL），
# 节点路由见 src/config.py 的 DEFAULT_NODE_MODELS。
#
# ⚠️ 两个 key 都是承重的：缺任一个管线都跑不起来（start.sh 与
#    health.py:check_config 用的是同一份 critical 清单）。
# ══════════════════════════════════════════════════════════════════

# === Qwen（判断层：READ / READBACK / REVIEW_TERMS / WRITE_FALLBACK）===
LLM_API_KEY=sk-your-qwen-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名变量是 QWEN_MODEL（不是 LLM_MODEL —— 那个名字没有任何代码读取）。
# 逐节点降档用 XIDU_NODE_MODEL_<NODE>，例：
#   XIDU_NODE_MODEL_READBACK=qwen3.8-flash
QWEN_MODEL=qwen3.8-max

# === GLM（文字层：WRITE 用 flash、FIX 用 full）===
GLM_API_KEY=sk-your-glm-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_FULL_MODEL=glm-5.3
# 思考强度：GLM 默认 max 档贵约 35 倍，必须显式设
GLM_WRITE_EFFORT=low
GLM_FIX_EFFORT=high

# === Anthropic Claude API (optional arbitration) ===
ANTHROPIC_API_KEY=

# === Redis (task queue broker + backend) ===
REDIS_URL=redis://redis:6379/0

# === Chroma ===
CHROMA_PERSIST_PATH=./data/chroma

# === Checkpoint SQLite ===
CHECKPOINT_DB_PATH=./data/checkpoints.db

# === Authentication ===
# Leave empty for dev mode (no auth required)
API_KEY=

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# === CMS Integration ===
CMS_SOURCE_TYPE=file          # 'file' or 'webhook'
CMS_FILE_BASE_DIR=./novels    # for file connector
CMS_WEBHOOK_URL=              # for webhook connector
CMS_WEBHOOK_API_KEY=          # for webhook connector

# === Server ===
HOST=0.0.0.0
API_PORT=8000
